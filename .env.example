# Copy to .env. Never commit .env.

# Address the server binds to. Docker sets IP=0.0.0.0 itself (Dockerfile and
# docker-compose.yml), whatever this file says. A server on 0.0.0.0 or a LAN
# address treats every request as remote: no key from the browser, no
# designing or deleting voices. Keep IP=127.0.0.1 on the server's own computer
# and with Cloudflare Tunnel.
IP=127.0.0.1
PORT=8080
# PUBLIC_PORT=8081   # Cloudflare Tunnel port (same IP); requests on it count as internet users
# PUBLIC_HOST=app.example.com   # required with PUBLIC_PORT: the tunnel's hostname(s), comma-separated, no port;
#                               # a request on PUBLIC_PORT for any other Host or Origin counts as remote
#                               # (blocks DNS rebinding); keep the tunnel from rewriting Host (httpHostHeader)

# Root for the job database, rendered audio and logs.
DATA_DIR=./data

# Google Gemini API key. The GEMINI_API_KEY environment variable wins over this
# line (the process environment first, then, on Windows, the user or machine
# environment). With no key anywhere the app still starts: a run from an
# interactive console asks for one (shown as *, checked with Google, saved
# here); otherwise a browser on the server's own computer (IP=127.0.0.1, PORT)
# may enter one. Scheduled tasks and other unattended starts should pass
# --non-interactive. A saved key leaves this file readable by its owner only
# (on Windows only on NTFS; a FAT/exFAT drive cannot restrict it).
GEMINI_API_KEY=your_api_key_here

# Optional overrides.
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts        # gemini-3.8-flash-lite-tts is a third cheaper
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite   # five words for download names; no thinking level is sent
# GEMINI_THINKING_LEVEL=low                    # low, medium or high; thinking is billed as output
# EXAM_BUDGET_USD=0.70                         # warn when one exam's Gemini spend passes this; 0 = no budget
# SPEECH_CACHE_HOURS=72                        # reuse synthesised speech this long after its last use; 0 = off
# VOICES_PATH=./data/voices.json        # version 2 voice overrides (accent+gender pools, announcer); a template is written if missing
# MUSIC_PATH=./data/music.wav           # 24 kHz mono 16-bit WAV for the start/end of an exam recording
# AUDIO_RETENTION_HOURS=24               # unsaved recordings are purged after this many hours; 0 keeps them all
# RUST_LOG=info

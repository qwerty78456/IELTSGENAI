# Environment Configuration for vmq_mvp

# Cổng mà ứng dụng sẽ lắng nghe. Mặc định là 8080 nếu không set.
PORT=8080

# (Tùy chọn) IP để bind. Thường dùng 0.0.0.0 khi deploy qua Docker.
IP=0.0.0.0

# Đường dẫn chứa dữ liệu (DB, Audio, Logs). Có thể là đường dẫn tuyệt đối hoặc tương đối.
DATA_DIR=./data

# Khóa API của Google Gemini. Bắt buộc phải có.
GEMINI_API_KEY=your_api_key_here

# Copy to .env. Never commit .env.

# Address the server binds to (0.0.0.0 inside Docker).
IP=0.0.0.0
PORT=8080

# Root for the job database, rendered audio and logs.
DATA_DIR=./data

# Google Gemini API key. Required at startup; provider validity is checked when generating.
GEMINI_API_KEY=your_api_key_here

# Optional overrides.
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
# VOICES_PATH=./data/voices.json        # gender+accent -> voice name; written with defaults if missing
# MUSIC_PATH=./data/music.wav           # 24 kHz mono 16-bit WAV for the start/end of an exam recording
# AUDIO_RETENTION_HOURS=24               # unsaved recordings are purged after this many hours; 0 keeps them all
# RUST_LOG=info
